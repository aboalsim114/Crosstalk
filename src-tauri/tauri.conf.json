{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Crosstalk",
  "version": "0.3.0",
  "identifier": "app.crosstalk.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Crosstalk",
        "width": 1320,
        "height": 840,
        "minWidth": 1100,
        "minHeight": 720,
        "center": true,
        "resizable": true,
        "decorations": false,
        "shadow": true,
        "backgroundColor": "#030304",
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi"
    ],
    "category": "Utility",
    "shortDescription": "Traduction en temps réel pour Counter-Strike 2",
    "longDescription": "Crosstalk traduit en français, en temps réel, les voix et le chat de vos coéquipiers dans Counter-Strike 2, sans injection ni lecture de la mémoire du jeu.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "French",
          "English"
        ],
        "displayLanguageSelector": false
      },
      "wix": {
        "language": [
          "fr-FR",
          "en-US"
        ]
      }
    }
  }
}
